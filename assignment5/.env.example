# Server
NODE_ENV=production
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/quickbank

# JWT
JWT_SECRET=replace-with-256-bit-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=replace-with-different-256-bit-secret
JWT_REFRESH_EXPIRY=7d

# Session
SESSION_SECRET=replace-with-64-byte-random-secret

# Encryption key for sensitive fields (32 bytes hex)
FIELD_ENCRYPTION_KEY=replace-with-32-byte-hex-key

# TOTP / 2FA issuer name
TOTP_ISSUER=QuickBank

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@quickbank.com
SMTP_PASS=replace-with-smtp-password
FROM_EMAIL=noreply@quickbank.com

# Transaction limits (USD cents)
SINGLE_TX_LIMIT_CENTS=500000
DAILY_TX_LIMIT_CENTS=1000000
TX_2FA_THRESHOLD_CENTS=100000

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
