{
  "name": "quickbank-secure",
  "version": "1.0.0",
  "description": "PCI DSS-compliant digital banking platform with fortress-level security",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "mongoose-field-encryption": "^4.0.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.9.7",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3",
    "rate-limit-mongo": "^2.3.2",
    "sanitize-html": "^2.11.0",
    "ua-parser-js": "^1.0.37",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "winston-mongodb": "^5.1.1",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/database.js"
    ]
