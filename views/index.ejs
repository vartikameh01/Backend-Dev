<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Employee Payroll Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container">
    <h1>Employee Payroll Dashboard</h1>

    <a href="/add" class="btn btn-add">+ Add New Employee</a>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Department</th>
          <th>Basic Salary</th>
          <th>Tax (12%)</th>
          <th>Net Salary</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (employees.length === 0) { %>
          <tr>
            <td colspan="7" class="no-data">No employees found. Add one!</td>
          </tr>
        <% } else { %>
          <% employees.forEach(function(emp, i) { %>
            <% let tax = emp.salary * 0.12; %>
            <% let netSalary = emp.salary - tax; %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= emp.name %></td>
              <td><%= emp.department %></td>
              <td>₹ <%= emp.salary.toLocaleString("en-IN") %></td>
              <td>₹ <%= tax.toLocaleString("en-IN") %></td>
              <td>₹ <%= netSalary.toLocaleString("en-IN") %></td>
              <td class="actions">
                <a href="/edit/<%= emp.id %>" class="btn btn-edit">Edit</a>
                <a href="/delete/<%= emp.id %>" class="btn btn-delete" onclick="return confirm('Are you sure you want to delete this employee?')">Delete</a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
